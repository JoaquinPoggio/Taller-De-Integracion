generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTE
  ADMINISTRADOR
}

model Usuario {
  id                 Int      @id @default(autoincrement())
  nombre             String
  correo             String   @unique
  proveedorRedSocial String
  idRedSocial        String
  rol                Rol      @default(CLIENTE)
  usuario            String?  @unique
  direccion          String?
  contacto           String?
  creadoEn           DateTime @default(now())

  @@unique([proveedorRedSocial, idRedSocial])
  @@map("usuarios")
}